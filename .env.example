# Contoh konfigurasi gopay-merchant-go — HANYA nama variabel + nilai dummy.
# JANGAN menaruh nomor HP, OTP, token, QRIS asli, atau secret apa pun di sini.
# Salin ke .env bila perlu mengubah nilai default (file .env TIDAK di-commit).
# File .env di folder kerja dibaca otomatis oleh binary (godotenv);
# env yang sudah di-set manual tetap menang atas isi .env.

# Port HTTP server. Default 3101 (bind selalu 127.0.0.1).
PORT=3101

# Interval loop polling opsional server dalam milidetik. Default 60000.
# Loop hanya aktif bila POLL_ENABLED=true; default loop MATI.
POLL_INTERVAL_MS=60000
POLL_ENABLED=false

# Direktori berisi orders.dummy.json dan mutations.dummy.json.
# Kosongkan / hapus baris ini untuk memakai folder data/ proyek.
# DATA_DIR=data

# --- Saklar sumber + klien GoBiz ---
# SOURCE: "mock" (default, baca file dummy) atau "gobiz"
# (siklus /proposals memakai GoBiz; file sesi hilang/tidak valid ->
# HTTP 500 sumber-gobiz-error, TANPA fallback ke mock).
# Nilai lain -> HTTP 500 konfigurasi-tidak-valid.
SOURCE=mock

# Base URL API transaksi GoBiz. Nilai default di kode adalah host
# dashboard web GoBiz (BUKAN klaim API resmi). Untuk tes, arahkan ke
# server tiruan lokal.
GOBIZ_BASE_URL=https://api.gojekapi.com

# Base URL auth (OTP/verify/config/refresh) — penulisan ulang
# transparan dari laporan studi (meniru dashboard web GoBiz, BUKAN
# API partner resmi; penerimaan live MASIH BELUM TERBUKTI, uji
# live hanya dengan akun dummy). Path bisa dikonfigurasi lewat
# GOBIZ_OTP_PATH / GOBIZ_VERIFY_PATH / GOBIZ_REFRESH_PATH /
# GOBIZ_MERCHANT_CONFIG_PATH untuk tes mock lokal.
GOBIZ_AUTH_BASE_URL=https://api.gobiz.co.id

# ID merchant — nilai DUMMY. Nilai ini HANYA FALLBACK bila langkah
# config login gagal mengambil merchant_id dari sesi. Bila config
# berhasil, merchant_id dari sesi yang dipakai saat polling. Jangan
# tulis merchant ID asli di sini.
GOBIZ_MERCHANT_ID=MERCHANT-DUMMY-001

# File sesi lokal service (hanya accessToken/refreshToken/expiresAt
# + bila ada merchantId/outletName, TANPA nomor HP/OTP; token di
# dalamnya plaintext). Nilai relatif diselesaikan ke working directory.
GOBIZ_SESSION_FILE=.gobiz-session.json

# --- Jembatan POC / reservasi MDR ---
# Token internal untuk POST /mdr/reserve — nilai DUMMY. Bila kosong,
# endpoint MDR menolak (tidak pernah terbuka tanpa auth). JANGAN
# token asli / token produksi di sini.
POLLER_INTERNAL_TOKEN=<redacted>

# Durasi reservasi MDR dalam ms (default 900000 = 15 menit).
# Ini konfigurasi module GoPay, BUKAN mengubah kontrak global 60+15.
POLLER_MDR_DURATION_MS=900000

# --- Store persisten (GORM + Postgres) ---
# DATABASE_URL adalah DSN Postgres untuk store reservations + claims.
# Contoh DUMMY (ganti host/port/user/password/nama DB di laptop):
#   postgres://user:password@localhost:5432/gopay_merchant?sslmode=disable
# Bila kosong, server memakai MemoryStore (demo/tes saja): klaim dan
# reservasi HILANG saat proses restart. Produksi WAJIB DATABASE_URL.
# AutoMigrate + store Postgres nyata BELUM teruji live di sandbox
# (tidak ada server Postgres di sini) — jalankan di laptop setelah
# transfer, dengan DATABASE_URL laptop sendiri.
# DATABASE_URL=postgres://user:password@localhost:5432/gopay_merchant?sslmode=disable

# --- Wire (cmd/wire) ---
# Alamat mitra-tools (default http://localhost:8080).
MITRA_BASE_URL=http://localhost:8080

# Token internal mitra-tools untuk endpoint /api/internal/topup/*.
# WAJIB diisi sebelum menjalankan wire; kosong -> exit 1 tanpa panggilan.
# Token ini BERBEDA dari POLLER_INTERNAL_TOKEN. Nilai DUMMY.
BRIDGE_INTERNAL_TOKEN=<redacted>

# Interval wire-loop (ms). Default 60000 / batas idle 300000.
WIRE_POLL_INTERVAL_MS=60000
WIRE_MAX_IDLE_MS=300000

# File log keputusan wire (default wire-decisions.log di working dir).
# WIRE_LOG_PATH=wire-decisions.log

# Path file UI server (default web/ui.html, dibaca dari disk tiap request).
# UI_PATH=web/ui.html
